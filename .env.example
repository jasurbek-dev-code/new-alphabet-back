# Telegram Bot Configuration
# Obtain your token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Database Configuration
# SQLite (default for development):
DATABASE_URL=sqlite+aiosqlite:///./app.db
# PostgreSQL (for production):
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/uzbek_translit_db

# Security & App Configuration
APP_ENV=development
DEBUG=True
ALLOWED_ORIGINS=*
# initData lifetime limit in seconds (default 86400 = 24 hours, 0 to disable expiration check)
INIT_DATA_MAX_AGE_SECONDS=86400
